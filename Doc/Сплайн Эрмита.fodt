   <text:p text:style-name="P74"><text:tab/><text:span text:style-name="T188">На рисунке ниже показан поворот в 3d. Вектор </text:span><text:span text:style-name="T188"><draw:frame draw:style-name="fr1" draw:name="Объект23" text:anchor-type="as-char" svg:y="-0.377cm" svg:width="0.238cm" svg:height="0.471cm" draw:z-index="6"><draw:object>
