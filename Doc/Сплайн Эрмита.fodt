     </draw:frame></text:span><text:span text:style-name="T129"><text:s/></text:span><text:span text:style-name="T140">имеет координаты (1, </text:span><text:span text:style-name="T141">d</text:span><text:span text:style-name="T12">y</text:span><text:span text:style-name="T140">). Нормализовав, и </text:span><text:span text:style-name="T129">повернув его на 90</text:span><text:span text:style-name="T130">0</text:span><text:span text:style-name="T140"> </text:span><text:span text:style-name="T129">получим Y`. </text:span><text:span text:style-name="T132">Далее векторно</text:span><text:span text:style-name="T133">е</text:span><text:span text:style-name="T132"> умнож</text:span><text:span text:style-name="T134">ение </text:span><text:span text:style-name="T140">X</text:span><text:span text:style-name="T129">` </text:span><text:span text:style-name="T135">и </text:span><text:span text:style-name="T129">Y` </text:span><text:span text:style-name="T133">даст </text:span><text:span text:style-name="T132">Z</text:span><text:span text:style-name="T129">`.</text:span></text:p>
   <text:p text:style-name="P46"/>
   <text:p text:style-name="P18"><text:span text:style-name="T37"><text:tab/></text:span><text:span text:style-name="T50">И</text:span><text:span text:style-name="T39">тоговы</text:span><text:span text:style-name="T50">й </text:span><text:span text:style-name="T50"><draw:frame draw:style-name="fr2" draw:name="Объект12" text:anchor-type="as-char" svg:y="-0.377cm" svg:width="0.434cm" svg:height="0.467cm" draw:z-index="15"><draw:object>
