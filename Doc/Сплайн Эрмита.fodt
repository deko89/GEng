         <annotation encoding="StarMath 5.0">alignl
left lbrace stack{
ap^2+bp^2=ab^2 #
op^2+bp^2=lline b rline^2 #
op+ap=lline a rline #
lline b rline cdot cos(aob)=op #
lline b rline cdot sin(aob)=bp #
ab^2=(a_x-b_x)^2+(a_y-b_y)^2 #
lline a rline^2=a_x^2+a_y^2 #
lline b rline^2=b_x^2+b_y^2
} right rbrace</annotation>
        </semantics>
