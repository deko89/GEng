   <text:h text:style-name="Heading_20_3" text:outline-level="3"><text:span text:style-name="T80">3.2 </text:span><text:span text:style-name="T81">Поворот </text:span><text:span text:style-name="T82">на 90</text:span><text:span text:style-name="T77">°</text:span></text:h>
   <text:p text:style-name="P18"><text:span text:style-name="T74">Поворот на 90° </text:span><text:span text:style-name="T73">можно сделать просто поменяв x и y местами и поменяв знак</text:span><text:span text:style-name="T72">:</text:span></text:p>
   <text:p text:style-name="P36"><draw:frame draw:style-name="fr2" draw:name="Объект19" text:anchor-type="as-char" svg:y="-0.594cm" svg:width="5.551cm" svg:height="1.106cm" draw:z-index="8"><draw:object>
      <math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
       <semantics>
        <mtable>
         <mtr>
          <mtd>
           <mrow>
            <mrow>
             <msub>
              <mi>x</mi>
              <mn>2</mn>
             </msub>
             <mo stretchy="false">=</mo>
             <mi>cos</mi>
            </mrow>
            <mrow>
             <mrow>
              <mo fence="true" form="prefix" stretchy="false">(</mo>
              <mrow>
               <mrow>
                <mi>a</mi>
                <mo stretchy="false">+</mo>
                <mrow>
                 <mi>π</mi>
                 <mo stretchy="false">/</mo>
                 <mn>2</mn>
                </mrow>
               </mrow>
              </mrow>
              <mo fence="true" form="postfix" stretchy="false">)</mo>
             </mrow>
             <mo stretchy="false">=</mo>
             <mrow>
              <mo stretchy="false">−</mo>
              <mi>sin</mi>
             </mrow>
            </mrow>
            <mrow>
             <mrow>
              <mo fence="true" form="prefix" stretchy="false">(</mo>
              <mrow>
               <mi>a</mi>
              </mrow>
              <mo fence="true" form="postfix" stretchy="false">)</mo>
             </mrow>
             <mo stretchy="false">=</mo>
             <mrow>
              <mo stretchy="false">−</mo>
              <mi>y</mi>
             </mrow>
            </mrow>
           </mrow>
          </mtd>
         </mtr>
         <mtr>
          <mtd columnalign="left">
           <mrow>
            <mrow>
             <msub>
              <mi>y</mi>
              <mn>2</mn>
             </msub>
             <mo stretchy="false">=</mo>
             <mi>sin</mi>
            </mrow>
            <mrow>
             <mrow>
              <mo fence="true" form="prefix" stretchy="false">(</mo>
              <mrow>
               <mrow>
                <mi>a</mi>
                <mo stretchy="false">+</mo>
                <mrow>
                 <mi>π</mi>
                 <mo stretchy="false">/</mo>
                 <mn>2</mn>
                </mrow>
               </mrow>
              </mrow>
              <mo fence="true" form="postfix" stretchy="false">)</mo>
             </mrow>
             <mo stretchy="false">=</mo>
             <mi>cos</mi>
            </mrow>
            <mrow>
             <mrow>
              <mo fence="true" form="prefix" stretchy="false">(</mo>
              <mrow>
               <mi>a</mi>
              </mrow>
              <mo fence="true" form="postfix" stretchy="false">)</mo>
             </mrow>
             <mo stretchy="false">=</mo>
             <mi>x</mi>
            </mrow>
           </mrow>
          </mtd>
         </mtr>
        </mtable>
        <annotation encoding="StarMath 5.0">x_2 = cos(a + %pi/2) = -sin(a) = -y
newline alignl
y_2 = sin(a + %pi/2) = cos(a) = x</annotation>
       </semantics>
      </math>
