     </draw:frame></text:span><text:span text:style-name="T188">, и </text:span><text:span text:style-name="T166">повернув его на 90</text:span><text:span text:style-name="T168">0</text:span><text:span text:style-name="T188"> </text:span><text:span text:style-name="T166">получим Y`. </text:span><text:span text:style-name="T180">Далее векторно</text:span><text:span text:style-name="T181">е</text:span><text:span text:style-name="T180"> умнож</text:span><text:span text:style-name="T182">ение </text:span><text:span text:style-name="T188">X</text:span><text:span text:style-name="T166">` </text:span><text:span text:style-name="T183">и </text:span><text:span text:style-name="T166">Y` </text:span><text:span text:style-name="T181">даст </text:span><text:span text:style-name="T180">Z</text:span><text:span text:style-name="T166">`.</text:span></text:p>
   <text:p text:style-name="P50"/>
   <text:p text:style-name="P18"><text:span text:style-name="T51"><text:tab/></text:span><text:span text:style-name="T64">И</text:span><text:span text:style-name="T53">тоговы</text:span><text:span text:style-name="T64">й </text:span><text:span text:style-name="T64"><draw:frame draw:style-name="fr1" draw:name="Объект12" text:anchor-type="as-char" svg:y="-0.377cm" svg:width="0.238cm" svg:height="0.471cm" draw:z-index="21"><draw:object>
