      <svg:desc>формула</svg:desc>
     </draw:frame></text:span><text:span text:style-name="T51">, который явля</text:span><text:span text:style-name="T52">е</text:span><text:span text:style-name="T51">тся тем же </text:span><text:span text:style-name="T51"><draw:frame draw:style-name="fr2" draw:name="Объект21" text:anchor-type="as-char" svg:y="-0.377cm" svg:width="0.434cm" svg:height="0.467cm" draw:z-index="14"><draw:object>
