          <mtd columnalign="left">
           <mrow>
            <mover accent="true">
             <mi>x</mi>
             <mo stretchy="false">⃗</mo>
            </mover>
            <mo stretchy="false">=</mo>
            <mrow>
             <mover accent="true">
              <msub>
               <mi>x</mi>
               <mrow>
                <mi>Y</mi>
                <mi>&apos;</mi>
               </mrow>
              </msub>
              <mo stretchy="false">⃗</mo>
             </mover>
             <mo stretchy="false">+</mo>
             <mover accent="true">
              <msub>
               <mi>x</mi>
               <mrow>
                <mi>Z</mi>
                <mi>&apos;</mi>
               </mrow>
              </msub>
              <mo stretchy="false">⃗</mo>
             </mover>
            </mrow>
           </mrow>
          </mtd>
         </mtr>
         <mtr>
          <mtd columnalign="left">
           <mrow>
            <mrow>
             <mover accent="true">
              <msub>
               <mi>x</mi>
               <mrow>
                <mi>Y</mi>
                <mi>&apos;</mi>
               </mrow>
              </msub>
              <mo stretchy="false">⃗</mo>
             </mover>
             <mo stretchy="false">=</mo>
             <mover accent="true">
              <mi>Y</mi>
              <mo stretchy="false">⃗</mo>
             </mover>
            </mrow>
            <mrow>
             <mi>&apos;</mi>
             <mo stretchy="false">∗</mo>
             <msub>
              <mi>a</mi>
              <mi>y</mi>
             </msub>
            </mrow>
           </mrow>
          </mtd>
         </mtr>
         <mtr>
          <mtd columnalign="left">
           <mrow>
            <mrow>
             <mover accent="true">
              <msub>
               <mi>x</mi>
               <mrow>
                <mi>Z</mi>
                <mi>&apos;</mi>
               </mrow>
              </msub>
              <mo stretchy="false">⃗</mo>
             </mover>
             <mo stretchy="false">=</mo>
             <mover accent="true">
              <mi>Z</mi>
              <mo stretchy="false">⃗</mo>
             </mover>
            </mrow>
            <mrow>
             <mi>&apos;</mi>
             <mo stretchy="false">∗</mo>
             <msub>
              <mi>a</mi>
              <mi>z</mi>
             </msub>
            </mrow>
           </mrow>
          </mtd>
         </mtr>
        </mtable>
        <annotation encoding="StarMath 5.0">alignl
vec x = vec x_{Y&apos;} + vec x_{Z&apos;}
newline alignl	
vec x_{Y&apos;} = vec Y&apos; * a_y
newline alignl
vec x_{Z&apos;} = vec Z&apos; * a_z</annotation>
       </semantics>
      </math>
     </draw:object><draw:image>
