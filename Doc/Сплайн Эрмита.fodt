        <semantics>
         <mover accent="true">
          <mi>x</mi>
          <mo stretchy="false">⃗</mo>
         </mover>
         <annotation encoding="StarMath 5.0">vec x</annotation>
        </semantics>
       </math>
      </draw:object><draw:image>
