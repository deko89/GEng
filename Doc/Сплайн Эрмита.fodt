     </draw:frame></text:span><text:span text:style-name="T64"><text:s/>на единичные векторы осей </text:span><text:span text:style-name="T71">Y’ и Z’</text:span><text:span text:style-name="T68">.</text:span></text:p>
   <text:p text:style-name="P49"><text:tab/></text:p>
   <text:p text:style-name="P41"><text:soft-page-break/><draw:frame draw:style-name="fr1" draw:name="Объект18" text:anchor-type="as-char" svg:y="-0.908cm" svg:width="1.997cm" svg:height="1.752cm" draw:z-index="24"><draw:object>
      <math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
       <semantics>
        <mtable>
