            <mo fence="true" form="postfix" stretchy="false">)</mo>
           </mrow>
          </mrow>
          <mi>L</mi>
         </mfrac>
        </mrow>
        <annotation encoding="StarMath 5.0">d = { f&apos;(w) } over L</annotation>
       </semantics>
      </math>
     </draw:object><draw:image>
