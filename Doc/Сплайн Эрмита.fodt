      <svg:desc>формула</svg:desc>
     </draw:frame></text:span><text:span text:style-name="T64"><text:s/>получим </text:span><text:span text:style-name="T70">сложив его проекции </text:span><text:span text:style-name="T72">на </text:span><text:span text:style-name="T64">ос</text:span><text:span text:style-name="T76">и</text:span><text:span text:style-name="T64"> </text:span><text:span text:style-name="T71">Y’ и Z’</text:span><text:span text:style-name="T70"> как вектора. Они находятся </text:span><text:span text:style-name="T64">умнож</text:span><text:span text:style-name="T70">ением</text:span><text:span text:style-name="T64"> </text:span><text:span text:style-name="T72">размеров</text:span><text:span text:style-name="T64"> </text:span><text:span text:style-name="T64"><draw:frame draw:style-name="fr1" draw:name="Объект13" text:anchor-type="as-char" svg:y="-0.377cm" svg:width="0.238cm" svg:height="0.471cm" draw:z-index="22"><draw:object>
       <math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
        <semantics>
         <mover accent="true">
          <mi>a</mi>
          <mo stretchy="false">⃗</mo>
         </mover>
         <annotation encoding="StarMath 5.0">vec a </annotation>
        </semantics>
       </math>
      </draw:object><draw:image>
