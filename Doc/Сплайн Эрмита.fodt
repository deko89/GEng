   <text:p text:style-name="P9"><text:span text:style-name="T24"><text:tab/></text:span><text:span text:style-name="T25">L</text:span><text:span text:style-name="T88"> - </text:span><text:span text:style-name="T34">расстояние между ключевыми точками по оси x</text:span><text:span text:style-name="T36">,</text:span><text:span text:style-name="T35"> </text:span><text:span text:style-name="T35"><draw:frame draw:style-name="fr2" draw:name="Объект4" text:anchor-type="as-char" svg:y="-0.379cm" svg:width="1.894cm" svg:height="0.531cm" draw:z-index="21"><draw:object>
       <math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
        <semantics>
         <mrow>
          <mi>L</mi>
          <mo stretchy="false">=</mo>
          <mrow>
           <msub>
            <mi>x</mi>
            <mn>1</mn>
           </msub>
           <mo stretchy="false">−</mo>
           <msub>
            <mi>x</mi>
            <mn>0</mn>
           </msub>
          </mrow>
         </mrow>
         <annotation encoding="StarMath 5.0">L = x_1 - x_0</annotation>
        </semantics>
       </math>
