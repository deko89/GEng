         <annotation encoding="StarMath 5.0">alignl
left lbrace stack{
bp^2=ab^2-ap^2 #
bp^2=lline b rline^2 - op^2 #
ap=lline a rline-op #
lline a rline cdot lline b rline cdot cos(aob) = a_x cdot b_x+a_y cdot b_y  #
lline a rline cdot lline b rline cdot sin(aob) = a_x cdot b_y-a_y cdot b_x
} right rbrace</annotation>
