     </draw:frame></text:span><text:span text:style-name="T65">, который явля</text:span><text:span text:style-name="T66">е</text:span><text:span text:style-name="T65">тся тем же </text:span><text:span text:style-name="T65"><draw:frame draw:style-name="fr1" draw:name="Объект21" text:anchor-type="as-char" svg:y="-0.377cm" svg:width="0.238cm" svg:height="0.471cm" draw:z-index="18"><draw:object>
