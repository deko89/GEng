        <annotation encoding="StarMath 5.0">alignl				ab^2-ap^2=lline b rline^2 - op^2
newline alignl	ab^2-(lline a rline-op)^2=lline b rline^2 - op^2
newline alignl	ab^2-(lline a rline^2-2 cdot lline a rline cdot op + op^2)=lline b rline^2 - op^2
newline alignl	ab^2-lline a rline^2+2 cdot lline a rline cdot op - op^2=lline b rline^2 - op^2
newline alignl	ab^2-lline a rline^2+2 cdot lline a rline cdot op=lline b rline^2
newline alignl	2 cdot lline a rline cdot op=lline b rline^2 - ab^2+lline a rline^2</annotation>
       </semantics>
