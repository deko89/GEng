   <text:p text:style-name="P10"/>
   <text:p text:style-name="P12"><text:span text:style-name="T3"><text:tab/>На концах отрезки гладко стыкуются между собой благодаря </text:span><text:span text:style-name="T103">равным</text:span><text:span text:style-name="T3"> производным в </text:span><text:span text:style-name="T103">ключевых</text:span><text:span text:style-name="T3"> точках </text:span><text:span text:style-name="T13">(которые задают угол)</text:span><text:span text:style-name="T3">. </text:span><text:span text:style-name="T138">Её </text:span><text:span text:style-name="T3">можно найти как средн</text:span><text:span text:style-name="T138">юю от </text:span><text:span text:style-name="T3">производны</text:span><text:span text:style-name="T100">х</text:span><text:span text:style-name="T3"> </text:span><text:span text:style-name="T138">прилегающих</text:span><text:span text:style-name="T3"> отрезков.</text:span></text:p>
   <text:p text:style-name="P6"/>
   <text:h text:style-name="P30" text:outline-level="2">2. Формула</text:h>
   <text:p text:style-name="P19"><text:tab/>Для упрощения вычислений используется подстановка - вместо прямого x <text:s/>используется w. <text:span text:style-name="T100">Он</text:span><text:span text:style-name="T104">а</text:span><text:span text:style-name="T100"> является</text:span><text:span text:style-name="T99"> коэффициент</text:span><text:span text:style-name="T100">ом</text:span><text:span text:style-name="T99"> позиции на отрезке:</text:span> 0 это начало отрезка, 1 конец.</text:p>
   <table:table table:name="Таблица5" table:style-name="Таблица5">
    <table:table-column table:style-name="Таблица5.A"/>
    <table:table-column table:style-name="Таблица5.B"/>
    <table:table-header-rows>
     <table:table-row>
      <table:table-cell table:style-name="Таблица5.A1" office:value-type="string">
       <text:p text:style-name="P65"><draw:frame draw:style-name="fr6" draw:name="Объект10" text:anchor-type="as-char" svg:y="-0.683cm" svg:width="2.027cm" svg:height="1.124cm" draw:z-index="6"><draw:object>
          <math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
           <semantics>
            <mrow>
             <mi>w</mi>
             <mo stretchy="false">=</mo>
             <mfrac>
              <mrow>
               <mi>x</mi>
               <mo stretchy="false">−</mo>
               <msub>
                <mi>x</mi>
                <mn>0</mn>
               </msub>
              </mrow>
              <mrow>
               <msub>
                <mi>x</mi>
                <mn>1</mn>
               </msub>
               <mo stretchy="false">−</mo>
               <msub>
                <mi>x</mi>
                <mn>0</mn>
               </msub>
              </mrow>
             </mfrac>
            </mrow>
            <annotation encoding="StarMath 5.0">w = { x - x_0 } over{ x_1 - x_0 }</annotation>
           </semantics>
          </math>
         </draw:object><draw:image>
