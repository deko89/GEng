               <mo stretchy="false">⋅</mo>
               <msub>
                <mi>b</mi>
                <mi>x</mi>
               </msub>
              </mrow>
              <mo stretchy="false">+</mo>
              <mrow>
               <msub>
                <mi>a</mi>
                <mi>y</mi>
               </msub>
               <mo stretchy="false">⋅</mo>
               <msub>
                <mi>b</mi>
                <mi>y</mi>
               </msub>
              </mrow>
             </mrow>
            </mrow>
           </mrow>
          </mtd>
         </mtr>
        </mtable>
        <annotation encoding="StarMath 5.0">alignl				2 cdot lline a rline cdot lline b rline cdot cos(aob)=lline a rline^2 + lline b rline^2 - ab^2
newline alignl	2 cdot lline a rline cdot lline b rline cdot cos(aob)=a_x^2+a_y^2 + b_x^2+b_y^2 - (a_x-b_x)^2-(a_y-b_y)^2
newline alignl	2 cdot lline a rline cdot lline b rline cdot cos(aob)=a_x^2+a_y^2 + b_x^2+b_y^2 - (a_x^2-2 cdot a_x cdot b_x + b_x^2)-(a_y^2-2 cdot a_y cdot b_y + b_y^2)
newline alignl	2 cdot lline a rline cdot lline b rline cdot cos(aob)= color red {a_x^2} + color blue {a_y^2} + color green {b_x^2} + color fuchsia {b_y^2} - color red {a_x^2} + 2 cdot a_x cdot b_x - color green {b_x^2} - color blue {a_y^2}  + 2 cdot a_y cdot b_y - color fuchsia {b_y^2}
newline alignl	2 cdot lline a rline cdot lline b rline cdot cos(aob)=2 cdot a_x cdot b_x + 2 cdot a_y cdot b_y
newline alignl	lline a rline cdot lline b rline cdot cos(aob)=a_x cdot b_x + a_y cdot b_y</annotation>
       </semantics>
      </math>
